# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure strong, unique secrets for production.
# ==============================================================================

# MongoDB Root Authentication Credentials
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_mongodb_root_password_here

# JWT HMAC-SHA256 Secret (Minimum 256 bits / 32 bytes Base64-encoded string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Microservice Inter-Service Communication API Keys & Webhook Secrets
PRODUCT_API_KEY=PRODUCT-SERVICE-SECRET-KEY
ORDER_API_KEY=order-secret-key-123
PAYMENT_API_KEY=payment-secret-key-123
NOTIFICATION_API_KEY=notification-secret-key-123
WEBHOOK_SECRET=soc-payment-webhook-secret-key-2026

# Microservice Network Routing URLs (Defaults for local development)
AUTH_SERVICE_URL=http://localhost:8084
PRODUCT_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8085
